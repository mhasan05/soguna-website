# Copy to .env and adjust. Never commit the real .env.

DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Default is SQLite (db.sqlite3). Production per PRD: PostgreSQL
# DATABASE_URL=postgres://sajs:password@localhost:5432/sajs

# Where the frontend is served from (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Origin used to build absolute media URLs (photos, vouchers) for the frontend
PUBLIC_API_ORIGIN=http://localhost:8000
# MEDIA_ROOT=/var/www/sajs/media

# SMS: "console" logs OTP codes and SMS to the server log; "bulksmsbd" sends real SMS
SMS_BACKEND=console
SMS_API_KEY=
SMS_SENDER_ID=SOGUNA

# DEV ONLY (ignored when DEBUG is off): every OTP becomes this code
OTP_DEV_CODE=123456
