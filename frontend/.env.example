# Django API (browser requests)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# Optional: server-side URL for cached page data (e.g. an internal address on the VPS)
# API_URL=http://127.0.0.1:8000/api

# Public site address — used for share links, OG tags and the member-card QR code
NEXT_PUBLIC_SITE_URL=https://soguna.org

# Optional, local development only: hint shown under the OTP box (matches backend OTP_DEV_CODE)
# NEXT_PUBLIC_OTP_HINT=ডেভ: কোড ১২৩৪৫৬
